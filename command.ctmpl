SET @@reservation = 'projects/${project_id}/locations/${location}/reservations/bq-reservation-${hex}';
EXPORT DATA OPTIONS (
  uri = 'https://bigtable.googleapis.com/projects/${project_id}/instances/bt-i-${hex}/appProfiles/bt-profile/tables/bt-t-${hex}',
  format = 'CLOUD_BIGTABLE',
  overwrite = true,
  -- auto_create_column_families = true,  -- Add this line
  bigtable_options = """{
    "columnFamilies": [
      {
        "familyId": "customers",
        "columns": [
          {"qualifierString": "email", "fieldName": "email"}                                                                                                                        ]
      }
    ]
  }"""
) AS SELECT
  CAST(email AS STRING) AS rowkey,
  STRUCT(
    CAST(id AS STRING) AS id,
    email
  ) AS  customers
FROM
  data_${hex}.customers;

